FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

# ── System dependencies ───────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    openjdk-17-jdk \
    wget \
    unzip \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ── Android SDK setup ─────────────────────────────────────────────────────────
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_NDK_HOME=$ANDROID_HOME/ndk/25.2.9519653
ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/build-tools/34.0.0

RUN mkdir -p $ANDROID_HOME/cmdline-tools
RUN wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
    -O /tmp/cmdline-tools.zip \
    && unzip -q /tmp/cmdline-tools.zip -d $ANDROID_HOME/cmdline-tools \
    && mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest \
    && rm /tmp/cmdline-tools.zip

RUN yes | sdkmanager --licenses && \
    sdkmanager \
        "platforms;android-34" \
        "build-tools;34.0.0" \
        "ndk;25.2.9519653" \
        "cmake;3.22.1" \
        "platform-tools"

# ── Project build ─────────────────────────────────────────────────────────────
WORKDIR /project
COPY . .

# ── Resolve symlinks broken by Docker COPY ────────────────────────────────────
# C/C++ backend sources (symlinked into src/android/app/src/main/cpp/)
RUN cp --remove-destination \
        /project/src/backend/api_handler.c     /project/src/android/app/src/main/cpp/api_handler.c    && \
    cp --remove-destination \
        /project/src/backend/api_handler.h     /project/src/android/app/src/main/cpp/api_handler.h    && \
    cp --remove-destination \
        /project/src/backend/config_manager.c  /project/src/android/app/src/main/cpp/config_manager.c && \
    cp --remove-destination \
        /project/src/backend/config_manager.h  /project/src/android/app/src/main/cpp/config_manager.h && \
    cp --remove-destination \
        /project/src/middleware/api_protocol.h /project/src/android/app/src/main/cpp/api_protocol.h

# Web assets (symlinked into src/android/app/src/main/assets/web/)
RUN mkdir -p /project/src/android/app/src/main/assets/web && \
    cp --remove-destination \
        /project/src/web/index.html /project/src/android/app/src/main/assets/web/index.html && \
    cp --remove-destination \
        /project/src/web/app.js     /project/src/android/app/src/main/assets/web/app.js     && \
    cp --remove-destination \
        /project/src/web/style.css  /project/src/android/app/src/main/assets/web/style.css

# Make gradlew executable and pre-fetch dependencies
RUN chmod +x src/android/gradlew

WORKDIR /project/src/android
RUN ./gradlew dependencies --no-daemon || true

CMD ["./gradlew", "assembleDebug", "--no-daemon"]
