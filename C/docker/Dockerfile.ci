FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libgtk-3-dev \
    clang \
    clang-tidy \
    clang-format \
    valgrind \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN chmod +x scripts/ci.sh

CMD ["./scripts/ci.sh"]
